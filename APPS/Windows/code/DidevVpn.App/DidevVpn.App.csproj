<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>didev-vpn</AssemblyName>
    <RootNamespace>DidevVpn.App</RootNamespace>
    <!-- build.ps1 sobrescribe esto con -p:Version=X.Y.Z en cada compilacion real; este valor solo se usa en dotnet build/F5 sueltos. -->
    <Version>0.1.0</Version>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- No usar trimming: no soportado para WinForms (NETSDK1175), ver APPS/Windows/NOTAS-prompt-12-en-pausa.md punto 10. -->
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\DidevVpn.Core\DidevVpn.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Management.Infrastructure" Version="3.0.0" />
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="8.0.1" />
    <PackageReference Include="TaskScheduler" Version="2.12.2" />
  </ItemGroup>

</Project>
