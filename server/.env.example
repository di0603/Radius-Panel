# -------- API --------
NODE_ENV=development
PORT=4000
# Origen permitido para CORS (la SPA en desarrollo). Debe ser exacto: el panel
# envia cookies y CORS no admite comodines cuando hay credenciales.
CORS_ORIGIN=http://localhost:5173
# Secreto para firmar los JWT y cifrar los secretos TOTP. Minimo 16 caracteres.
# Si lo cambias, todos los 2FA dados de alta dejan de funcionar y hay que rehacerlos.
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio

# -------- Sesiones del panel --------
# Vida del access token (corta: se renueva solo con el refresh token).
ACCESS_TOKEN_TTL=15m
# Dias que dura la sesion sin volver a escribir la contrasena.
REFRESH_TOKEN_DAYS=7
# Cookie Secure: true / false / auto (auto = activa solo en produccion).
# Si sirves el panel por HTTPS detras de nginx, dejalo en auto con NODE_ENV=production.
COOKIE_SECURE=auto
COOKIE_SAMESITE=lax

# -------- Proteccion del login --------
# Fallos consecutivos antes de bloquear la cuenta.
LOGIN_MAX_ATTEMPTS=5
# Minutos que dura el bloqueo y ventana en la que se cuentan los fallos.
LOGIN_LOCK_MINUTES=15
LOGIN_WINDOW_MINUTES=15
# Nombre que veran los administradores en su app de autenticacion (2FA).
TOTP_ISSUER=Radius Panel

# -------- Observabilidad --------
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# Expone /metrics en formato Prometheus.
METRICS_ENABLED=true

# -------- MySQL: base de datos de FreeRADIUS --------
RADIUS_DB_HOST=127.0.0.1
RADIUS_DB_PORT=3306
RADIUS_DB_USER=radius
RADIUS_DB_PASSWORD=radpass
RADIUS_DB_NAME=radius

# -------- MySQL: base de datos del panel --------
# Si usas el mismo servidor MySQL, repite host/credenciales y cambia solo el nombre.
PANEL_DB_HOST=127.0.0.1
PANEL_DB_PORT=3306
PANEL_DB_USER=radius
PANEL_DB_PASSWORD=radpass
PANEL_DB_NAME=radius_panel
# Conexiones simultaneas por pool.
DB_POOL_SIZE=10

# -------- Desconexion de sesiones (RFC 5176 Disconnect-Request) --------
# Puerto CoA/Disconnect al que escucha el NAS (normalmente 3799).
COA_PORT=3799
# Tiempo de espera de la respuesta del NAS, en ms.
COA_TIMEOUT_MS=3000
# Ponlo en false para deshabilitar el boton "Desconectar" del panel.
COA_ENABLED=true

# -------- Probar autenticacion desde el panel (Access-Request PAP) --------
RADIUS_TEST_ENABLED=true
RADIUS_AUTH_HOST=127.0.0.1
RADIUS_AUTH_PORT=1812
# El panel debe estar dado de alta como cliente en FreeRADIUS con este secret.
RADIUS_AUTH_SECRET=testing123
RADIUS_AUTH_TIMEOUT_MS=3000

# -------- Semilla del primer administrador (opcional) --------
# Si defines estas dos, `npm run seed:admin` las usa sin preguntar.
SEED_ADMIN_USER=admin
SEED_ADMIN_PASSWORD=

# -------- Login con Google (opcional) --------
# Requiere aplicar antes sql/panel-schema-google.sql. Ponlo en false para
# apagar el boton de Google sin borrar las credenciales.
GOOGLE_ENABLED=true
# Sacadas de Google Cloud Console -> APIs & Services -> Credentials -> OAuth
# client ID (tipo "Web application"). Vacias = sin boton de Google.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# -------- PKI de la VPN (opcional) --------
# Cifra la clave privada de la CA intermedia (panel_pki_ca.private_key_encrypted).
# Minimo 32 caracteres, aleatorio. Sin ella el panel arranca igual, pero
# generar o usar la CA intermedia falla con un mensaje claro al intentarlo.
# Si la cambias despues de generar una CA intermedia, esa clave privada deja
# de poder descifrarse: no hay forma de recuperarla.
PKI_MASTER_KEY=

# -------- EST (RFC 7030) para dispositivos VPN (opcional) --------
# Listener HTTPS propio, con TLS mutuo, para que los dispositivos pidan su
# primer certificado (simpleenroll) y lo renueven solos (simplereenroll). No
# pasa por nginx: necesita ver el certificado de cliente directamente. Sin
# EST_TLS_CERT/EST_TLS_KEY el panel arranca igual, sin este listener.
EST_ENABLED=true
# Puerto e IP donde escucha (192.168.10.28 en el servidor real; 0.0.0.0 = todas).
EST_PORT=8443
EST_BIND=0.0.0.0
# Certificado/clave TLS del propio listener, para el nombre publico de la PKI
# (p.ej. pki.vlc.didev.es). Los firma la CA raiz offline (EKU serverAuth, SAN
# DNS = ese nombre) -no Let's Encrypt-: los dispositivos deben confiar solo en
# esa raiz para esta conexion, no en el almacen de confianza general.
EST_TLS_CERT=
EST_TLS_KEY=
