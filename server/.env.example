# -------- API --------
PORT=4000
# Origen permitido para CORS (la SPA en desarrollo)
CORS_ORIGIN=http://localhost:5173
# Secreto para firmar los JWT del panel. Cambialo por una cadena larga y aleatoria.
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio
JWT_EXPIRES_IN=8h

# -------- MySQL: base de datos de FreeRADIUS --------
RADIUS_DB_HOST=127.0.0.1
RADIUS_DB_PORT=3306
RADIUS_DB_USER=radius
RADIUS_DB_PASSWORD=radpass
RADIUS_DB_NAME=radius

# -------- MySQL: base de datos del panel --------
# Si usas el mismo servidor MySQL, repite host/credenciales y cambia solo el nombre.
PANEL_DB_HOST=127.0.0.1
PANEL_DB_PORT=3306
PANEL_DB_USER=radius
PANEL_DB_PASSWORD=radpass
PANEL_DB_NAME=radius_panel

# -------- Desconexion de sesiones (RFC 5176 Disconnect-Request) --------
# Puerto CoA/Disconnect al que escucha el NAS (normalmente 3799).
COA_PORT=3799
# Tiempo de espera de la respuesta del NAS, en ms.
COA_TIMEOUT_MS=3000
# Ponlo en false para deshabilitar el boton "Desconectar" del panel.
COA_ENABLED=true

# -------- Probar autenticacion desde el panel (Access-Request PAP) --------
RADIUS_TEST_ENABLED=true
RADIUS_AUTH_HOST=127.0.0.1
RADIUS_AUTH_PORT=1812
# El panel debe estar dado de alta como cliente en FreeRADIUS con este secret.
RADIUS_AUTH_SECRET=testing123
RADIUS_AUTH_TIMEOUT_MS=3000

# -------- Semilla del primer administrador (opcional) --------
# Si defines estas dos, `npm run seed:admin` las usa sin preguntar.
SEED_ADMIN_USER=admin
SEED_ADMIN_PASSWORD=
