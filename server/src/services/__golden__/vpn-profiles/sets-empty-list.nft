#!/usr/sbin/nft -f
# Generado por Radius Panel (VPN -> Perfiles de acceso) - NO EDITAR A MANO
# Rellena los sets de los perfiles que YA existen en "inet filter" (ver el fragmento de
# nftables.conf). Solo "flush set" + "add element": no declara tablas ni cadenas.
# Se carga en una sola transaccion (nft -f): o cambian todos los sets o ninguno.
# Aplicar con deploy/vpn-gateway-apply-profiles.sh. Generado: 2026-01-01T00:00:00.000Z

flush set inet filter vpn_lan_restricted_ips
add element inet filter vpn_lan_restricted_ips { 192.168.10.100-192.168.10.104 }
flush set inet filter vpn_lan_full_ips
add element inet filter vpn_lan_full_ips { 192.168.10.105-192.168.10.109 }
flush set inet filter vpn_internet_only_ips
add element inet filter vpn_internet_only_ips { 192.168.10.110-192.168.10.114 }
flush set inet filter vpn_internet_lan_restricted_ips
add element inet filter vpn_internet_lan_restricted_ips { 192.168.10.115-192.168.10.119 }
flush set inet filter vpn_internet_lan_full_ips
add element inet filter vpn_internet_lan_full_ips { 192.168.10.75-192.168.10.99 }
flush set inet filter vpn_restricted_dests
flush set inet filter vpn_restricted_icmp
