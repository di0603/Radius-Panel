# Dependencias
node_modules/

# Builds
dist/
build/

# Entorno y secretos (nunca subir: credenciales de BD, JWT_SECRET, secrets de NAS)
.env
.env.*
!.env.example

# Logs
*.log
npm-debug.log*

# Editores / sistema
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# Cache de herramientas
.eslintcache
*.tsbuildinfo
coverage/

# Claude Code (config local, no compartida)
.claude/settings.local.json

# didev-vpn-windows: build.ps1 deja aqui el .exe/.msi/SHA256SUMS.txt en local,
# nunca se suben al repo (ver APPS/Windows/README.md)
APPS/Windows/ejecutables/*
!APPS/Windows/ejecutables/.gitkeep

# Salida de compilacion .NET (bin/obj de cada proyecto de APPS/Windows/code)
APPS/Windows/code/**/bin/
APPS/Windows/code/**/obj/
APPS/Windows/code/**/*.user
