# Copiar a /etc/freeradius-vpn-ca-sync/config.sh en la .28, con permisos 600
# (no lleva ningun secreto en si, pero es configuracion de seguridad: mejor
# que solo root pueda tocarla): chmod 600 /etc/freeradius-vpn-ca-sync/config.sh

# URL del listener HTTP normal del panel, SOLO por loopback (no expuesto
# fuera de la .28): sirve la cadena de CA y la CRL sin autenticacion, es
# informacion publica (server/src/routes/pkiPublic.ts, montado en /pki).
# Ajusta el puerto si PORT en server/.env no es 1003.
PANEL_PKI_URL='http://127.0.0.1:1003/pki'

# Directorio ca_path de FreeRADIUS para el virtual server "vpn" (ver
# mods-enabled/eap o el sites-enabled/vpn de esta instalacion): donde ya
# estan la raiz y su CRL, puestas a mano. Este script SOLO anade/actualiza
# sus propios ficheros ahi (panel-intermediate-N.pem, panel-crl.pem), nunca
# toca los de la raiz.
CA_PATH='/etc/freeradius/3.0/certs/vpn/ca'

# Ruta EXACTA al fichero de la raiz offline que YA esta en CA_PATH (ajusta
# el nombre al que tenga de verdad en esta instalacion: no lo adivina el
# script a proposito, para no arriesgarse a coger el fichero equivocado si
# hubiera mas de uno).
ROOT_CERT_FILE="$CA_PATH/ca.pem"

# Huella SHA-256 (hex, en minusculas o mayusculas, sin separadores) del DER
# de esa raiz: se comprueba en cada ejecucion ANTES de descargar nada, para
# detectar si ROOT_CERT_FILE ha cambiado de lo esperado (raiz equivocada,
# configuracion desactualizada tras rotar la raiz...). Calculala con:
#   openssl x509 -in "$CA_PATH/ca.pem" -outform DER | openssl dgst -sha256
ROOT_CERT_SHA256='pega-aqui-la-huella-sha256-de-la-raiz'

# Nombre de la unidad systemd de FreeRADIUS en esta instalacion (normalmente
# "freeradius" en Debian/Ubuntu, a veces "radiusd" en otras distros).
FREERADIUS_SERVICE='freeradius'

# Fichero donde comprobar si ya existe "ca_path_reload_interval" (FreeRADIUS
# 3.2+): si esta configurado ahi, FreeRADIUS relee ca_path el solo, sin
# reload ni restart, y este script no fuerza ninguno de los dos. Ajusta la
# ruta al fichero real de esta instalacion si no es mods-enabled/eap (podria
# estar en el sites-enabled/vpn si el tls-config es especifico de ese
# virtual server).
TLS_CONFIG_FILE='/etc/freeradius/3.0/mods-enabled/eap'
